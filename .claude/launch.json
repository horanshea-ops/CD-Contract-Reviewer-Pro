{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "next-dev",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev"],
      "port": 3000
    },
    {
      "name": "next-dev-sonnet-5-5",
      "runtimeExecutable": "env",
      "runtimeArgs": ["ANTHROPIC_MODEL=claude-sonnet-5-5", "npm", "run", "dev", "--", "-p", "3010"],
      "port": 3010
    },
    {
      "name": "next-prod",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "start", "--", "-p", "3001"],
      "port": 3001
    }
  ]
}
